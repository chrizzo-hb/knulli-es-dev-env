    "stdexcept": "cpp",
    "streambuf": "cpp",
    "compare": "cpp",
    "exception": "cpp",
    "initializer_list": "cpp",
    "new": "cpp",
    "typeinfo": "cpp",
    "array": "cpp",
    "cmath": "cpp",
    "cstring": "cpp",
    "list": "cpp",
    "format": "cpp",
    "fstream": "cpp",
    "numbers": "cpp",
    "span": "cpp",
    "text_encoding": "cpp",
    "*.icc": "cpp",
    "io_context": "cpp",
    "socket": "cpp",
    "timer": "cpp",
    "barrier": "cpp",
    "condition_variable": "cpp",
    "future": "cpp",
    "latch": "cpp",
    "cfenv": "cpp",
    "cinttypes": "cpp",
    "csignal": "cpp",
    "bitset": "cpp",
    "deque": "cpp",
    "forward_list": "cpp",
    "unordered_map": "cpp",
    "unordered_set": "cpp",
    "any": "cpp",
    "internet": "cpp",
    "iterator": "cpp",
    "netfwd": "cpp",
