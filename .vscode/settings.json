    "variant": "cpp",
    "queue": "cpp",
    "stack": "cpp",
    "csetjmp": "cpp",
    "*.inc": "cpp"
  },

  // Improving performance by excluding files/folders from watcher
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    // Buildroot / Knulli-Linux artefacts
    "**/knulli-linux/output/**": true,
    "**/knulli-linux/dl/**": true,
    "**/knulli-linux/buildroot/**": true,
    "**/knulli-linux/host/**": true,
    "**/knulli-linux/target/**": true,
    "**/knulli-linux/staging/**": true,
    // EmulationStation build and cache folders
    "**/knulli-emulationstation/build/**": true,
    "**/knulli-emulationstation/.cmake/**": true,
    "**/*.o": true,
    "**/*.a": true,
    "**/*.so": true
  },

  "search.exclude": {
    "**/node_modules": true,
    "**/knulli-linux/output": true,
    "**/knulli-linux/dl": true,
    "**/knulli-linux/buildroot": true,
    "**/knulli-linux/host": true,
    "**/knulli-linux/target": true,
    "**/knulli-linux/staging": true,
    "**/knulli-emulationstation/build": true
  },

  // Use performance-efficient Tag Parser engine
  "C_Cpp.default.intelliSenseEngine": "Tag Parser",
  // Limit concurrent threads to avoid blocking out CPU entirely
  "C_Cpp.maxConcurrentThreads": 1,
  "C_Cpp.maxCachedProcesses": 2,

  "C_Cpp.files.exclude": {
    "**/knulli-linux/output/**": true,
    "**/knulli-linux/dl/**": true,
    "**/knulli-linux/buildroot/**": true,
    "**/knulli-emulationstation/build/**": true
  }
}